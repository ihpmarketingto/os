{
  "stableId": "sample_client_adapter",
  "clientId": "{{CLIENT_ID}}",
  "clientName": "{{CLIENT_NAME}}",
  "founderIdentityIds": ["{{FOUNDER_IDENTITY_ID}}"],
  "teamIdentityIds": ["{{TEAM_IDENTITY_ID}}"],
  "brandIdentityId": "{{BRAND_IDENTITY_ID}}",
